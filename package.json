{
  "name": "zen-notes-mod",
  "version": "2.5.1",
  "private": true,
  "description": "Zen Notes: a block-based sticky-notes widget for Zen Browser, distributed through Sine",
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "validate": "node scripts/validate.js",
    "check": "biome check . && node scripts/validate.js && node --test test/*.test.js",
    "build": "node scripts/build-release.js",
    "harness": "node scripts/launch-zen.js --browser",
    "zen": "node scripts/launch-zen.js",
    "zen:test": "node scripts/launch-zen.js --test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "linkedom": "^0.18.12"
  },
  "engines": {
    "node": ">=22"
  }
}
