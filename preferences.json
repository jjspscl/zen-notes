[
  {
    "type": "text",
    "label": "Zen Notes",
    "margin": "20px 0 8px 0",
    "size": "20px"
  },
  {
    "type": "text",
    "label": "Sine-first global notes library for Zen. Workspaces pin an active note, while creation, rename, delete, and ordering live in the in-browser manager.",
    "margin": "0 0 18px 0"
  },
  {
    "type": "separator",
    "label": "Sidebar"
  },
  {
    "type": "dropdown",
    "property": "zen.notes.appearance",
    "label": "Appearance",
    "defaultValue": "system",
    "options": [
      { "label": "System (follow browser)", "value": "system" },
      { "label": "Light", "value": "light" },
      { "label": "Dark", "value": "dark" }
    ]
  },
  {
    "type": "checkbox",
    "property": "zen.notes.collapsed",
    "label": "Start with the widget collapsed",
    "defaultValue": false,
    "margin": "12px 0"
  },
  {
    "type": "string",
    "property": "zen.notes.height",
    "label": "Default expanded height",
    "value": "number",
    "defaultValue": 220,
    "placeholder": "220"
  },
  {
    "type": "dropdown",
    "property": "zen.notes.colorMode",
    "label": "Color mode",
    "defaultValue": "classic",
    "options": [
      { "label": "Classic (five pastels)", "value": "classic" },
      { "label": "Adapt to browser theme", "value": "adapt" },
      { "label": "Color preset", "value": "preset" }
    ]
  },
  {
    "type": "dropdown",
    "property": "zen.notes.preset",
    "label": "Color preset",
    "defaultValue": "catppuccin-latte",
    "options": [
      { "label": "Catppuccin Latte (light)", "value": "catppuccin-latte" },
      { "label": "Catppuccin Frappé", "value": "catppuccin-frappe" },
      { "label": "Catppuccin Macchiato", "value": "catppuccin-macchiato" },
      { "label": "Catppuccin Mocha", "value": "catppuccin-mocha" },
      { "label": "Dracula", "value": "dracula" },
      { "label": "Nord", "value": "nord" },
      { "label": "Gruvbox Dark", "value": "gruvbox-dark" },
      { "label": "Gruvbox Light", "value": "gruvbox-light" },
      { "label": "Tokyo Night", "value": "tokyo-night" },
      { "label": "Rosé Pine", "value": "rose-pine" },
      { "label": "Rosé Pine Dawn (light)", "value": "rose-pine-dawn" },
      { "label": "Solarized Dark", "value": "solarized-dark" },
      { "label": "Solarized Light", "value": "solarized-light" },
      { "label": "Everforest Dark", "value": "everforest-dark" },
      { "label": "Everforest Light", "value": "everforest-light" }
    ]
  },
  {
    "type": "text",
    "label": "Color mode determines how the note surface looks. Classic uses the five original pastels. Adapt follows your active browser theme (Nebula, Natsumi, Zen default, etc.). Preset picks a hardcoded palette from popular color schemes.",
    "margin": "0 0 18px 0"
  },
  {
    "type": "separator",
    "label": "Workspace"
  },
  {
    "type": "checkbox",
    "property": "zen.notes.showWorkspaceKey",
    "label": "Show current workspace key inside the manager",
    "defaultValue": false,
    "margin": "12px 0"
  },
  {
    "type": "text",
    "label": "Workspace pinned-note state depends on Zen exposing a stable active workspace identifier. Zen Notes keeps migration data local and preserves legacy single-note prefs for recovery.",
    "margin": "8px 0 0 0"
  }
]
