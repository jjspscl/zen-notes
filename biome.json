{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "scripts/**", "test/**", "*.json", "!package-lock.json"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": { "quoteStyle": "double" },
    "globals": ["window", "document", "Services", "IOUtils", "PathUtils", "ChromeUtils", "Cc", "Ci", "XPCOMUtils"]
  },
  "css": { "parser": { "cssModules": false }, "formatter": { "enabled": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off", "useTemplate": "off", "noDescendingSpecificity": "off" },
      "complexity": { "noForEach": "off", "useOptionalChain": "warn", "noImportantStyles": "off" },
      "suspicious": { "noAssignInExpressions": "off", "noEmptyBlockStatements": "off" }
    }
  }
}
